# Copy to .env on the server (or run scripts/export-env.ps1 on Windows from local env vars)
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me

DEEPSEEK_API_KEY=
LIVEAVATAR_API_KEY=
ELEVENLABS_API_KEY=

FLASK_DEBUG=false
GUNICORN_WORKERS=1
LOG_DIR=/app/logs

# Global API rate limit (semicolon-separated). Empty = no default cap.
RATE_LIMIT_DEFAULT=800 per hour;3000 per day
