# Host nginx (no Docker). Domain spe-avatar.com :80 → 127.0.0.1:3003
# Direct IP access: http://47.238.75.193:3003 (Gunicorn, not port 80)
#
# DNS: A 记录 @ 和 www → 47.238.75.193
# Install:
#   sudo cp scripts/nginx-spe-avatar.conf.example /etc/nginx/sites-available/spe-avatar.com
#   sudo ln -sf /etc/nginx/sites-available/spe-avatar.com /etc/nginx/sites-enabled/
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name spe-avatar.com www.spe-avatar.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # 视频由 Nginx 直出磁盘，避免经 Gunicorn（大 MP4 会卡）
    location /static/videos/ {
        alias /home/spe_avatar/interrogation-app/static/videos/;
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        add_header Accept-Ranges bytes;
        expires 7d;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:3003;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_buffering off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ~ /\. {
        deny all;
    }
}
